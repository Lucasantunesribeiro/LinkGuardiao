ASPNETCORE_ENVIRONMENT=Development
AWS_REGION=us-east-1
DDB_TABLE_LINKS=linkguardiao-links-dev
DDB_TABLE_USERS=linkguardiao-users-dev
DDB_TABLE_ACCESS=linkguardiao-access-dev
DDB_TABLE_DAILY_LIMITS=linkguardiao-limits-dev
DDB_TABLE_REFRESH_TOKENS=linkguardiao-refresh-tokens-dev
DDB_TABLE_EMAIL_LOCKS=linkguardiao-email-locks-dev
DDB_SERVICE_URL=http://localhost:8000
STORAGE_PROVIDER=dynamodb
# Senha do PostgreSQL local do docker compose (apenas desenvolvimento)
POSTGRES_PASSWORD=linkguardiao
POSTGRESQL_CONNECTION_STRING=Host=localhost;Port=54329;Database=linkguardiao;Username=linkguardiao;Password=linkguardiao
REDIS_CONNECTION_STRING=localhost:6380
# Obrigatorio, >= 32 caracteres. Gere um valor aleatorio, ex.: openssl rand -base64 48
JWT__SECRET=<defina-um-segredo-aleatorio-com-32-ou-mais-caracteres>
JWT__ISSUER=LinkGuardiao
JWT__AUDIENCE=LinkGuardiao
JWT__ACCESSTOKENMINUTES=60
CORS_ALLOWED_ORIGIN=http://localhost:5173
LINKLIMITS__DAILYUSERCREATELIMIT=100
